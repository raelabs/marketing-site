---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroRotating from '../components/HeroRotating.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ProductSection from '../components/ProductSection.astro';
import AgentHarnessBar from '../components/AgentHarnessBar.astro';
import ScreenshotPlaceholder from '../components/ScreenshotPlaceholder.astro';
import { ContactButton } from '../components/ContactButton';
---

<BaseLayout
  title="rae — the trust harness for autonomous work"
  description="The trust harness for autonomous work. Real-time proof-of-behavior enforcement for every agent, on every team."
>
  <Nav />

  <main>
    <HeroRotating
      title="The trust harness for autonomous work."
      highlight="trust harness"
      subtitle="Don't prompt and pray for quality work at an efficient token spend. Enforce it."
    >
      <ScreenshotPlaceholder
        slot="media"
        name="rae"
        accentColor="var(--lp-primary)"
      />
    </HeroRotating>
    <LogoMarquee
      logos={[
        { name: 'Cisco', src: '/images/logos/cisco.svg', height: 'h-10', width: 'w-20' },
        { name: 'Twilio', src: '/images/logos/twilio.svg', height: 'h-10', width: 'w-32' },
        { name: 'Uber', src: '/images/logos/uber.svg', height: 'h-8', width: 'w-22' },
        { name: 'Indeed', src: '/images/logos/indeed.svg', height: 'h-8', width: 'w-28' },
        { name: 'Berkeley SkyDeck', src: '/images/logos/berkeley-skydeck.svg', height: 'h-6', width: 'w-56' },
        { name: 'RetailMeNot', src: '/images/logos/retailmenot.svg', height: 'h-8', width: 'w-40' },
        { name: 'ComPsych', src: '/images/logos/compsych.svg', height: 'h-8', width: 'w-40' },
        { name: 'Adept', src: '/images/logos/adept.svg', height: 'h-8', width: 'w-44' },
      ]}
    />

    <!-- Agent Behaviors — flagship -->
    <ProductSection
      id="products"
      headline="Guarantee your SDLC and SOPs"
      body="Real-time proof-of-behavior enforcement."
      eyebrow="Agent Behaviors"
      screenshotName="Agent Behaviors"
      screenshotAccent="var(--lp-primary)"
      layout="left"
      reveal
      revealDelay="1.4s"
      ctaText="Get access"
      ctaHref="/products/agent-behaviors"
      maturity="Available now"
    />

    <AgentHarnessBar
      heading="Works with your agent harness"
      tools={[
        { name: 'Claude Code', logo: '/images/logos/claude-code.svg' },
        { name: 'Cursor', logo: '/images/logos/cursor.svg' },
        { name: 'Antigravity', logo: '/images/logos/antigravity.svg' },
        { name: 'Codex', logo: '/images/logos/codex.svg' },
      ]}
    />

    <!-- raegent -->
    <ProductSection
      headline="Trust every agent. On every team. All at once."
      body="The trust meta-harness for every coding agent — run and review the work, all in one place."
      eyebrow="raegent"
      screenshotName="raegent"
      screenshotAccent="var(--lp-secondary)"
      layout="right"
      ctaText="Get early access"
      ctaHref="/products/raegent"
      maturity="Coming soon"
    />

    <!-- rae skills -->
    <ProductSection
      headline="Measure once. Cut once, correctly."
      body="Take autonomous work from zero-to-100 with a guaranteed SDLC."
      eyebrow="rae skills"
      screenshotName="rae skills"
      screenshotAccent="var(--lp-primary)"
      layout="left"
      ctaText="Get early access"
      ctaHref="/products/rae-skills"
      maturity="Coming soon"
    />

    <!-- Closing CTA -->
    <section class="py-24 px-6 bg-muted/20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-title mb-4">Ready to trust your (agent) team?</h2>
        <p class="text-lg text-subtext mb-8">Enforce quality work at an efficient token spend — proven, not promised.</p>
        <ContactButton
          client:load
          source="homepage_cta"
          className="inline-block text-base font-medium px-8 py-3 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          Get access
        </ContactButton>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
