---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ScreenshotPlaceholder from '../../components/ScreenshotPlaceholder.astro';
import { ContactButton } from '../../components/ContactButton';
import { ContactForm } from '../../components/ContactForm';

const pillars = [
  {
    title: 'The trust meta-harness<br />for every agent',
    body: 'raegent is the web app your whole team runs every coding agent in — kick off work, watch it happen live, and pick up any thread across sessions. Built on <a href="https://omnigent.ai/" target="_blank" rel="noopener" class="text-primary underline underline-offset-4 hover:opacity-80 transition-opacity">Omnigent</a>, it supports every harness and model provider you’ll ever use — with behaviors, review, and trace built in.',
    screenshot: 'raegent — Meta-harness',
    accent: 'var(--lp-primary)',
    layout: 'left',
  },
  {
    title: 'Review trust signals,<br />not every line',
    body: 'raeview surfaces the trust signals behind an agent’s work — the decisions, the evidence, the path it took — so you can judge it on what actually happened instead of scrolling a thousand-line diff. Trust PRs twice as much, in half the time.',
    screenshot: 'raeview — Review',
    accent: 'var(--lp-secondary)',
    layout: 'right',
  },
  {
    title: 'rae, wherever<br />you work',
    body: 'Review lives where your team already does. raeview is the primary surface in raegent — and drops straight into the harness you already use, popping a structured review in-flow and handing the feedback back to the agent without breaking stride.',
    screenshot: 'raeview — Embedded anywhere',
    accent: 'var(--lp-primary)',
    layout: 'left',
  },
];
---

<BaseLayout
  title="raegent — the trust meta-harness for every agent"
  description="Trust every agent, on every team, all at once. raegent is the trust meta-harness — run every coding agent in one place, with review built in."
>
  <Nav />

  <main class="pt-24">
    <!-- Hero -->
    <section class="py-20 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block mb-6 text-sm font-medium px-3 py-1.5 rounded-full bg-muted text-subtext border border-border">
          Coming soon
        </span>
        <h1 class="text-4xl md:text-6xl font-bold text-title mb-6 text-balance">
          Trust every agent. On every team. All at once.
        </h1>
        <p class="text-lg md:text-xl text-subtext max-w-3xl mx-auto leading-relaxed text-balance">
          <span class="text-primary font-semibold">raegent</span> is the trust meta-harness for every coding agent — one place to run the work and review it, for your whole team.
        </p>
        <div class="mt-10 flex justify-center">
          <ContactButton client:load source="raegent_cta" className="text-base px-6 py-3">
            Get early access
          </ContactButton>
        </div>
      </div>
    </section>

    <!-- Problem: context switching + review burden (joint) -->
    <section class="py-20 px-6 border-y border-border bg-muted/20">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-xl md:text-2xl text-title leading-relaxed text-balance mb-12">
          Every week your team runs more agents, across more tools — and the work scatters with them. Sessions to catch up on, diffs to read, PRs piling up faster than anyone can review. Approving code you can’t fully vouch for becomes the new normal, and the oversight tax lands hardest on the people you trust most.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 max-w-4xl mx-auto">
          <div>
            <p class="text-4xl md:text-5xl font-bold text-primary mb-2">39%</p>
            <p class="text-sm text-subtext leading-snug text-balance">more errors from AI oversight fatigue</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold text-primary mb-2">34%</p>
            <p class="text-sm text-subtext leading-snug">higher intent to quit</p>
          </div>
          <div>
            <p class="text-4xl md:text-5xl font-bold text-primary mb-2">91%</p>
            <p class="text-sm text-subtext leading-snug">longer PR review times</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <div id="pillars">
      {pillars.map((pillar, i) => (
        <section class="py-24 px-6">
          <div class:list={[
            'max-w-6xl mx-auto flex flex-col gap-12 items-center',
            pillar.layout === 'left' ? 'md:flex-row' : 'md:flex-row-reverse',
          ]}>
            <div class="flex-1 w-full order-1 md:order-none">
              <ScreenshotPlaceholder name={pillar.screenshot} accentColor={pillar.accent} />
            </div>
            <div class="flex-1 md:max-w-md order-2 md:order-none">
              <p class="text-sm uppercase tracking-wider text-secondary mb-3">0{i + 1}</p>
              <h2 class="text-3xl md:text-4xl font-bold text-title mb-4" set:html={pillar.title}></h2>
              <p class="text-lg text-subtext leading-relaxed" set:html={pillar.body}></p>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Built on rae trace -->
    <section class="py-16 px-6 border-y border-border">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-title mb-3">
          Built on <a href="/products/rae-trace" class="text-primary underline underline-offset-4 hover:opacity-80 transition-opacity">rae trace</a>
        </h2>
        <p class="text-base md:text-lg text-subtext max-w-3xl mx-auto leading-relaxed text-balance">
          Everything that runs in raegent — every agent action and every review — is recorded by the real-time behavioral trace stream. OTel-compliant, cross-harness, open spec.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section id="join" class="py-24 px-6 bg-muted/20">
      <div class="max-w-md mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-title mb-3">
            Run every agent with trust.
          </h2>
          <p class="text-lg text-subtext">
            Get early access and bring every coding agent your team uses into one place where trust — and review — are built in.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6 shadow-sm">
          <ContactForm client:load source="raegent_cta" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
