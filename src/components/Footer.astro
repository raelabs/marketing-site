---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const products = [
  { href: '/products/agent-behaviors', label: 'Agent Behaviors' },
  { href: '/products/raegent', label: 'raegent' },
  { href: '/products/rae-skills', label: 'rae skills' },
  { href: '/products/rae-trace', label: 'rae trace' },
];
---

<footer class="border-t border-border bg-muted/30">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between gap-10">
      <div class="flex items-center gap-3 text-title">
        <Logo class="h-8 w-auto" />
        <span class="text-sm text-subtext">rae</span>
      </div>

      <div class="flex flex-wrap gap-12 text-sm">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-title">Products</span>
          {products.map((product) => (
            <a href={product.href} class="text-subtext hover:text-title transition-colors">{product.label}</a>
          ))}
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-title">Company</span>
          <a href="/services" class="text-subtext hover:text-title transition-colors">Services</a>
          <a href="/blog" class="text-subtext hover:text-title transition-colors">Blog</a>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-border text-center text-sm text-subtext">
      <p>&copy; {currentYear} Responsible Autonomous Engineering Labs</p>
    </div>
  </div>
</footer>
