---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted/30">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-3 text-title">
        <Logo class="h-8 w-auto" />
        <span class="text-sm text-subtext">rae</span>
      </div>

      <div class="flex items-center gap-6 text-sm text-subtext">
        <a href="#products" class="hover:text-title transition-colors">Products</a>
        <a href="/blog" class="hover:text-title transition-colors">Blog</a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-border text-center text-sm text-subtext">
      <p>&copy; {currentYear} Responsible Autonomous Engineering Labs</p>
    </div>
  </div>
</footer>
